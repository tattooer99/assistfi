{
  "name": "crypto-brief-mini-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check scripts/set-webhook.mjs",
    "set-webhook": "node --env-file-if-exists=.env scripts/set-webhook.mjs"
  }
}
